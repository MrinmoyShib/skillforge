# ==============================================================================
# SkillForge — Production Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env.prod` in the project root:
#    cp .env.prod.example .env.prod
# 2. Fill in strong, random passwords for SECRET_KEY, POSTGRES_PASSWORD, REDIS_PASSWORD.
# 3. Update your domain in ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS, CSRF_TRUSTED_ORIGINS.
# 4. NEVER commit `.env.prod` to git.
# ==============================================================================

# --- Django Production Settings ---
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1

# --- Database Credentials (PostgreSQL 16) ---
POSTGRES_DB=skillforge
POSTGRES_USER=skillforge
POSTGRES_PASSWORD=generate-a-strong-db-password-here
DATABASE_URL=postgres://skillforge:generate-a-strong-db-password-here@postgres:5432/skillforge

# --- Cache & Task Queue (Redis 7 & Celery) ---
REDIS_PASSWORD=generate-a-strong-redis-password-here
CELERY_BROKER_URL=redis://:generate-a-strong-redis-password-here@redis:6379/0
CELERY_RESULT_BACKEND=redis://:generate-a-strong-redis-password-here@redis:6379/0

# --- Sandboxed Execution (Judge0 CE) ---
JUDGE0_URL=http://judge0-server:2358
JUDGE0_AUTH_TOKEN=skillforge-judge0-dev-token

# --- Security, CORS & CSRF ---
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
SECURE_SSL_REDIRECT=False
AUTH_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True

# --- Exposed Port ---
PORT=80

